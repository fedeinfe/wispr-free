// The dictation pill (spec §1). The transparent window is larger than the capsule so the tooltip
// fits. All placement comes from wf_core::pill through the capsule-* properties, and the window
// only catches the mouse while the cursor is over the capsule.

component CardButton {
    in property <string> label;
    in property <brush> fill;
    in property <brush> ink;
    callback clicked();

    height: 22px;

    Rectangle {
        border-radius: 6px;
        background: touch.has-hover ? root.fill.brighter(25%) : root.fill;
    }

    Text {
        text: root.label;
        color: root.ink;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export enum PillLook { hidden, resting, ready, listening, locked, processing, error, meeting }

component Bars {
    in property <[float]> heights;
    in property <float> bar-scale: 1;
    property <length> bar-width: 3px;
    property <length> bar-gap: 3px;

    width: 10 * self.bar-width + 9 * self.bar-gap;

    for bar-height[index] in root.heights: Rectangle {
        x: index * (root.bar-width + root.bar-gap);
        y: (root.height - self.height) / 2;
        width: root.bar-width;
        height: max(2px, bar-height * root.height * root.bar-scale);
        border-radius: self.width / 2;
        background: #f4f1ea;
    }
}

component RoundButton {
    in property <string> glyph;
    in property <brush> fill;
    in property <brush> ink;
    callback clicked();

    width: 22px;
    height: 22px;

    Rectangle {
        border-radius: self.height / 2;
        background: touch.has-hover ? root.fill.brighter(25%) : root.fill;
    }

    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.glyph;
        fill: transparent;
        stroke: root.ink;
        stroke-width: 1.6px;
        stroke-line-cap: round;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component PillWindow inherits Window {
    in property <PillLook> look: PillLook.resting;
    in property <length> capsule-x;
    in property <length> capsule-y;
    in property <length> capsule-width;
    in property <length> capsule-height;
    in property <[float]> bars;
    in property <float> bar-scale: 1;
    in property <string> tooltip;
    in property <[string]> recent-transcripts;
    in property <[string]> microphones;
    // Device ids, in the order of `microphones`.
    in property <[string]> microphone-ids;
    in property <[string]> languages;
    in property <[string]> pipeline-qualities;
    in property <bool> card-shown;
    in property <length> card-x;
    in property <length> card-y;
    in property <length> card-width;
    in property <length> card-height;
    // The meeting app the suggestion card names.
    in property <string> card-app;

    callback pill-pressed();
    callback pill-released();
    callback cancel-clicked();
    callback stop-clicked();
    callback take-notes();
    callback decline-notes();
    callback paste-last();
    callback paste-recent(index: int);
    callback select-microphone(index: int);
    callback select-language(index: int);
    callback select-pipeline-quality(index: int);
    callback open-meetings();
    callback open-settings();
    callback hide-for-an-hour();
    callback quit();
    // Other threads left something for the UI thread to collect.
    callback events-arrived();

    title: "wispr-free pill";
    width: 320px;
    height: 120px;
    no-frame: true;
    background: transparent;

    capsule := Rectangle {
        property <bool> translucent: root.look == PillLook.resting;

        x: root.capsule-x;
        y: root.capsule-y;
        width: root.capsule-width;
        height: root.capsule-height;
        visible: root.look != PillLook.hidden;
        border-radius: min(self.width, self.height) / 2;
        background: self.translucent ? #17161c80 : #17161c;
        border-width: root.look == PillLook.error || root.look == PillLook.meeting ? 1.5px : 1px;
        border-color: root.look == PillLook.error ? #e5484d
            : root.look == PillLook.meeting ? #30a46c
            : #ffffff33;

        animate x, y, width, height {
            duration: 100ms;
            easing: ease-out;
        }

        if root.look == PillLook.processing: Rectangle {
            property <float> turns: animation-tick() / 1400ms;

            border-radius: parent.border-radius;
            border-width: 1.5px;
            border-color: @linear-gradient(self.turns * 360deg, #ffffff14 0%, #ffffffd0 50%, #ffffff14 100%);
        }

        capsule-touch := TouchArea {
            pointer-event(event) => {
                if event.button == PointerEventButton.left {
                    if event.kind == PointerEventKind.down {
                        root.pill-pressed();
                    } else if event.kind == PointerEventKind.up
                        || event.kind == PointerEventKind.cancel {
                        root.pill-released();
                    }
                }
            }
        }

        // Above the TouchArea, which would otherwise swallow the right button too. Left clicks
        // fall through it.
        ContextMenuArea {
            enabled: root.look == PillLook.ready;

            Menu {
                MenuItem {
                    title: "Paste last transcript";
                    activated => { root.paste-last(); }
                }
                Menu {
                    title: "Recent transcripts";
                    for transcript[index] in root.recent-transcripts: MenuItem {
                        title: transcript;
                        activated => { root.paste-recent(index); }
                    }
                }
                Menu {
                    title: "Microphone";
                    for microphone[index] in root.microphones: MenuItem {
                        title: microphone;
                        activated => { root.select-microphone(index); }
                    }
                }
                Menu {
                    title: "Language";
                    for language[index] in root.languages: MenuItem {
                        title: language;
                        activated => { root.select-language(index); }
                    }
                }
                Menu {
                    title: "Pipeline quality";
                    for quality[index] in root.pipeline-qualities: MenuItem {
                        title: quality;
                        activated => { root.select-pipeline-quality(index); }
                    }
                }
                MenuSeparator {}
                MenuItem {
                    title: "Meetings";
                    activated => { root.open-meetings(); }
                }
                MenuItem {
                    title: "Settings";
                    activated => { root.open-settings(); }
                }
                MenuItem {
                    title: "Hide for 1 hour";
                    activated => { root.hide-for-an-hour(); }
                }
                MenuItem {
                    title: "Quit";
                    activated => { root.quit(); }
                }
            }
        }

        if root.look == PillLook.listening || root.look == PillLook.locked
            || root.look == PillLook.meeting: Bars {
            height: parent.height - 8px;
            y: 4px;
            heights: root.bars;
            bar-scale: root.bar-scale;
        }

        if root.look == PillLook.locked: cancel-button := RoundButton {
            x: 5px;
            glyph: "M 2 2 L 8 8 M 8 2 L 2 8";
            fill: #ffffff24;
            ink: #f4f1ea;
            clicked => { root.cancel-clicked(); }
        }

        if root.look == PillLook.locked: stop-button := RoundButton {
            x: parent.width - self.width - 5px;
            glyph: "M 1.5 5.5 L 4 8 L 8.5 2.5";
            fill: #f4f1ea;
            ink: #17161c;
            clicked => { root.stop-clicked(); }
        }
    }

    if root.tooltip != "": Rectangle {
        x: max(4px, min(root.width - self.width - 4px,
            root.capsule-x + (root.capsule-width - self.width) / 2));
        y: root.capsule-y - self.height - 6px;
        width: min(label.preferred-width + 16px, root.width - 8px);
        height: 24px;
        border-radius: 6px;
        background: #17161c;

        label := Text {
            width: parent.width - 16px;
            text: root.tooltip;
            color: #f4f1ea;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    if root.card-shown: Rectangle {
        x: root.card-x;
        y: root.card-y;
        width: root.card-width;
        height: root.card-height;
        border-radius: 10px;
        background: #17161c;
        border-width: 1px;
        border-color: #ffffff33;

        Text {
            x: 10px;
            y: 8px;
            width: parent.width - 20px;
            text: "Take notes for this \{root.card-app} meeting?";
            color: #f4f1ea;
            font-size: 12px;
            overflow: elide;
        }

        take-notes-button := CardButton {
            x: parent.width - self.width - 10px;
            y: parent.height - self.height - 8px;
            width: 76px;
            label: "Take notes";
            fill: #f4f1ea;
            ink: #17161c;
            clicked => { root.take-notes(); }
        }

        decline-notes-button := CardButton {
            x: parent.width - self.width - 92px;
            y: parent.height - self.height - 8px;
            width: 62px;
            label: "Not now";
            fill: #ffffff24;
            ink: #f4f1ea;
            clicked => { root.decline-notes(); }
        }
    }
}
