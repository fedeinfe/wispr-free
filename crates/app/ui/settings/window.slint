// The Settings window (spec §5). Rust creates it on open and drops it on close.
import { ScrollView, Palette } from "std-widgets.slint";
import { Prefs, SettingsValues, ShortcutRow, MicrophoneRow, LanguageRow, ReplacementRow, SnippetRow, ModelRow } from "bridge.slint";
import { Theme } from "theme.slint";
import { ErrorText } from "controls.slint";
import { GeneralPage } from "pages/general.slint";
import { ModelsPage } from "pages/models.slint";
import { PipelinePage } from "pages/pipeline.slint";
import { StylePage } from "pages/style.slint";
import { MeetingsPage } from "pages/meetings.slint";
import { SoundsPage } from "pages/sounds.slint";
import { PrivacyPage } from "pages/privacy.slint";
import { AboutPage } from "pages/about.slint";

export { Prefs, SettingsValues, ShortcutRow, MicrophoneRow, LanguageRow, ReplacementRow, SnippetRow, ModelRow }

component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();

    height: 32px;
    border-radius: 6px;
    background: selected ? Theme.surface : touch.has-hover ? Theme.hover : transparent;
    accessible-role: tab;
    accessible-label: label;
    accessible-item-selected: selected;
    accessible-action-default => {
        clicked();
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Image {
            width: 16px;
            source: root.icon;
            colorize: root.selected ? Theme.accent : Theme.muted;
            image-fit: contain;
        }

        Text {
            text: root.label;
            color: root.selected ? Theme.text : Theme.muted;
            font-size: Theme.body-text;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component SettingsWindow inherits Window {
    in-out property <int> page;
    property <int> theme: Prefs.values.theme;
    property <[{ label: string, icon: image }]> pages: [
        { label: "General", icon: @image-url("../icons/settings/general.svg") },
        { label: "Models", icon: @image-url("../icons/settings/models.svg") },
        { label: "Pipeline", icon: @image-url("../icons/settings/pipeline.svg") },
        { label: "Style & dictionary", icon: @image-url("../icons/settings/style.svg") },
        { label: "Meetings", icon: @image-url("../icons/settings/meetings.svg") },
        { label: "Sounds & media", icon: @image-url("../icons/settings/sounds.svg") },
        { label: "Privacy & data", icon: @image-url("../icons/settings/privacy.svg") },
        { label: "About", icon: @image-url("../icons/settings/about.svg") },
    ];

    function apply-theme() {
        Palette.color-scheme = Prefs.values.theme == 1 ? ColorScheme.light : Prefs.values.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    title: "wispr-free settings";
    icon: @image-url("../icons/tray.svg");
    preferred-width: 880px;
    preferred-height: 640px;
    min-width: 760px;
    min-height: 480px;
    background: Theme.background;

    init => {
        Theme.system-dark = Palette.color-scheme == ColorScheme.dark;
        if Prefs.values.theme != 0 {
            root.apply-theme();
        }
    }

    changed theme => {
        root.apply-theme();
    }

    changed page => {
        scroller.content-y = 0;
    }

    HorizontalLayout {
        Rectangle {
            width: 200px;
            background: Theme.sidebar;

            VerticalLayout {
                padding: 12px;
                padding-top: 16px;
                spacing: 2px;
                alignment: start;

                for page[index] in root.pages: SidebarItem {
                    label: page.label;
                    icon: page.icon;
                    selected: root.page == index;
                    clicked => {
                        root.page = index;
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;

            Text {
                height: 58px;
                x: 24px;
                text: root.pages[root.page].label;
                color: Theme.text;
                font-size: Theme.heading-text;
                font-weight: 600;
                vertical-alignment: center;
            }

            if Prefs.notice != "": Rectangle {
                height: 34px;

                ErrorText {
                    x: 24px;
                    width: parent.width - 48px;
                    text: Prefs.notice;
                }
            }

            scroller := ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    width: scroller.visible-width;

                    if root.page == 0: GeneralPage { }
                    if root.page == 1: ModelsPage { }
                    if root.page == 2: PipelinePage { }
                    if root.page == 3: StylePage { }
                    if root.page == 4: MeetingsPage { }
                    if root.page == 5: SoundsPage { }
                    if root.page == 6: PrivacyPage { }
                    if root.page == 7: AboutPage { }
                }
            }
        }
    }
}
