// Our own controls, so that every part of the window uses the palette in theme.slint.
import { Palette } from "std-widgets.slint";
import { Prefs } from "bridge.slint";
import { Theme } from "theme.slint";

// A window that follows the theme setting.
export component ThemedWindow inherits Window {
    property <int> theme: Prefs.values.theme;

    function apply-theme() {
        Palette.color-scheme = Prefs.values.theme == 1 ? ColorScheme.light : Prefs.values.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    background: Theme.background;
    icon: @image-url("../icons/tray.svg");

    init => {
        Theme.system-dark = Palette.color-scheme == ColorScheme.dark;
        if Prefs.values.theme != 0 {
            root.apply-theme();
        }
    }

    changed theme => {
        root.apply-theme();
    }
}

export component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    // Onboarding's list only shows where you are.
    in property <bool> interactive: true;
    callback clicked();

    height: 34px;
    border-radius: Theme.control-radius;
    background: selected ? Theme.accent-soft : touch.has-hover && interactive ? Theme.hover : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    accessible-role: tab;
    accessible-label: label;
    accessible-item-selected: selected;
    accessible-action-default => {
        clicked();
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Image {
            width: 16px;
            source: root.icon;
            colorize: root.selected ? Theme.accent : Theme.muted;
            image-fit: contain;
        }

        Text {
            text: root.label;
            color: root.selected ? Theme.text : Theme.muted;
            font-size: Theme.body-text;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The app's name at the top of a sidebar.
export component SidebarBrand inherits HorizontalLayout {
    height: 34px;
    padding-left: 8px;
    spacing: 9px;

    Image {
        width: 22px;
        source: @image-url("../icons/app-icon.svg");
        image-fit: contain;
        accessible-role: none;
    }

    Text {
        text: "wispr-free";
        color: Theme.text;
        font-size: Theme.title-text;
        font-weight: 700;
        vertical-alignment: center;
    }
}

export component Label inherits Text {
    color: Theme.text;
    font-size: Theme.body-text;
    wrap: word-wrap;
}

export component Hint inherits Text {
    color: Theme.muted;
    font-size: Theme.small-text;
    wrap: word-wrap;
}

export component Toggle inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();

    function flip() {
        if enabled {
            checked = !checked;
            toggled();
        }
    }

    width: 38px;
    height: 22px;
    border-radius: self.height / 2;
    background: checked ? Theme.accent : Theme.track;
    animate background { duration: 140ms; easing: ease-out; }
    opacity: enabled ? 1 : 0.5;
    accessible-role: switch;
    accessible-label: label;
    accessible-checked: checked;
    accessible-enabled: enabled;
    accessible-action-default => {
        flip();
    }

    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        width: 18px;
        height: 18px;
        border-radius: self.height / 2;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000040;
        animate x { duration: 140ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.flip();
        }
    }
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked();

    min-width: label.preferred-width + 28px;
    height: Theme.control-height;
    border-radius: Theme.control-radius;
    background: primary
        ? (touch.pressed ? Theme.accent.darker(10%) : touch.has-hover && enabled ? Theme.accent.brighter(8%) : Theme.accent)
        : (touch.pressed ? Theme.track : touch.has-hover && enabled ? Theme.hover : Theme.control);
    animate background { duration: 120ms; easing: ease-out; }
    opacity: enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => {
        if enabled {
            clicked();
        }
    }

    label := Text {
        text: root.text;
        color: root.primary ? Theme.on-accent : root.danger ? Theme.danger : Theme.text;
        font-size: Theme.body-text;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Select inherits Rectangle {
    in property <string> label;
    in property <[string]> options;
    in property <bool> enabled: true;
    in-out property <int> current;
    callback selected();

    width: 200px;
    height: Theme.control-height;
    border-radius: Theme.control-radius;
    background: touch.has-hover && enabled ? Theme.hover : Theme.control;
    animate background { duration: 120ms; easing: ease-out; }
    opacity: enabled ? 1 : 0.5;
    accessible-role: combobox;
    accessible-label: label;
    accessible-value: options[current];

    Text {
        x: 10px;
        width: parent.width - 30px;
        text: root.options[root.current];
        color: Theme.text;
        font-size: Theme.body-text;
        overflow: elide;
        vertical-alignment: center;
    }

    Path {
        x: parent.width - 19px;
        y: (parent.height - self.height) / 2;
        width: 9px;
        height: 5px;
        commands: "M 0 0 L 4.5 5 L 9 0";
        stroke: Theme.muted;
        stroke-width: 1.5px;
        fill: transparent;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;

        Rectangle {
            background: Theme.surface;
            border-radius: Theme.control-radius;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.shadow;

            VerticalLayout {
                padding: 4px;

                for option[index] in root.options: Rectangle {
                    height: 30px;
                    border-radius: Theme.small-radius;
                    background: option-touch.has-hover ? Theme.hover : transparent;

                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        text: option;
                        color: index == root.current ? Theme.accent : Theme.text;
                        font-size: Theme.body-text;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    option-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current = index;
                            root.selected();
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

export component Field inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> multiline;
    in-out property <string> text;
    callback edited();
    callback accepted();

    function focus-input() {
        input.focus();
    }

    min-width: 80px;
    height: multiline ? 76px : Theme.control-height;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.control;
    background: Theme.control;

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            root.focus-input();
        }
    }

    Text {
        x: input.x;
        y: input.y;
        width: input.width;
        height: multiline ? self.preferred-height : input.height;
        visible: root.text == "";
        text: root.placeholder;
        color: Theme.muted;
        font-size: Theme.body-text;
        vertical-alignment: multiline ? top : center;
        wrap: multiline ? word-wrap : no-wrap;
        overflow: elide;
    }

    input := TextInput {
        x: 10px;
        y: multiline ? 8px : 0;
        width: parent.width - 20px;
        height: parent.height - (multiline ? 16px : 0);
        text <=> root.text;
        color: Theme.text;
        font-size: Theme.body-text;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;
        single-line: !root.multiline;
        wrap: root.multiline ? word-wrap : no-wrap;
        vertical-alignment: root.multiline ? top : center;
        accessible-label: root.label;
        edited => {
            root.edited();
        }
        accepted => {
            root.accepted();
        }
    }
}

export component Stepper inherits Rectangle {
    in property <string> label;
    in property <string> unit;
    in property <int> minimum: 1;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <bool> enabled: true;
    in-out property <int> value;
    callback changed-by-user();

    function change(by: int) {
        value = max(minimum, min(maximum, value + by));
        changed-by-user();
    }

    width: 150px;
    height: Theme.control-height;
    opacity: enabled ? 1 : 0.5;
    accessible-role: spinbox;
    accessible-label: label;
    accessible-value: value;
    accessible-enabled: enabled;
    accessible-action-increment => {
        if enabled {
            change(step);
        }
    }
    accessible-action-decrement => {
        if enabled {
            change(-step);
        }
    }

    HorizontalLayout {
        spacing: 6px;

        Btn {
            width: 32px;
            text: "−";
            enabled: root.enabled && root.value > root.minimum;
            clicked => {
                root.change(-root.step);
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.value + " " + root.unit;
            color: Theme.text;
            font-size: Theme.body-text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Btn {
            width: 32px;
            text: "+";
            enabled: root.enabled && root.value < root.maximum;
            clicked => {
                root.change(root.step);
            }
        }
    }
}

// A titled group of rows on a page.
export component Card inherits Rectangle {
    in property <string> title;
    in property <string> hint;

    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.dark ? transparent : Theme.shadow;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        if root.title != "": VerticalLayout {
            spacing: 3px;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.title-text;
                font-weight: 600;
            }

            if root.hint != "": Hint {
                text: root.hint;
            }
        }

        @children
    }
}

// A label on the left and a control on the right.
export component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;

    spacing: 16px;
    alignment: stretch;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;

        Label {
            text: root.label;
        }

        if root.hint != "": Hint {
            text: root.hint;
        }
    }

    @children
}

export component ToggleRow inherits Row {
    in-out property <bool> checked;
    in property <bool> enabled: true;

    VerticalLayout {
        alignment: center;

        Toggle {
            label: root.label;
            enabled: root.enabled;
            checked <=> root.checked;
            toggled => {
                Prefs.commit();
            }
        }
    }
}

export component SelectRow inherits Row {
    in-out property <int> current;
    in property <[string]> options;

    VerticalLayout {
        alignment: center;

        Select {
            label: root.label;
            options: root.options;
            current <=> root.current;
            selected => {
                Prefs.commit();
            }
        }
    }
}

export component StepperRow inherits Row {
    in-out property <int> value;
    in property <string> unit;
    in property <int> minimum: 1;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <bool> enabled: true;

    VerticalLayout {
        alignment: center;

        Stepper {
            label: root.label;
            unit: root.unit;
            minimum: root.minimum;
            maximum: root.maximum;
            step: root.step;
            enabled: root.enabled;
            value <=> root.value;
            changed-by-user => {
                Prefs.commit();
            }
        }
    }
}

// The title of a page and its scrolling cards are in window.slint; this is the page's column.
export component Page inherits VerticalLayout {
    padding: 28px;
    padding-top: 0;
    spacing: 16px;
    alignment: start;
}

// A tick for what's ready, an exclamation mark for what needs attention. Drawn rather than typed,
// so it doesn't depend on the font having the glyph.
export component StatusMark inherits Rectangle {
    in property <bool> ok;
    // Not known yet, so neither a tick nor a warning.
    in property <bool> waiting;

    width: 14px;
    height: 14px;
    border-radius: 7px;
    background: waiting ? Theme.track : ok ? Theme.accent : Theme.danger;

    if root.ok && !root.waiting: Path {
        x: 3px;
        y: 4px;
        width: 8px;
        height: 6px;
        commands: "M 0 3 L 3 6 L 8 0";
        stroke: Theme.on-accent;
        stroke-width: 1.5px;
        fill: transparent;
    }

    if !root.ok && !root.waiting: Text {
        text: "!";
        color: Theme.on-accent;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ErrorText inherits Text {
    color: Theme.danger;
    font-size: Theme.small-text;
    wrap: word-wrap;
}
