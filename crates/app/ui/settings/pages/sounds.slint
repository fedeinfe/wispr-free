import { Prefs } from "../bridge.slint";
import { Card, Page, SelectRow, ToggleRow } from "../controls.slint";

export component SoundsPage inherits Page {
    Card {
        ToggleRow {
            label: "Sounds";
            hint: "Short start, stop, lock and error sounds.";
            checked <=> Prefs.values.sounds;
        }

        SelectRow {
            label: "While dictating";
            hint: "Mute silences every app until you stop talking. Pause only reaches Music and Spotify: macOS doesn't tell apps what else is playing, so browsers and other apps keep playing. macOS asks once before each player can be controlled. Media is left alone during a meeting.";
            options: ["Leave media alone", "Mute system output", "Pause media"];
            current <=> Prefs.values.media-while-dictating;
        }
    }
}
