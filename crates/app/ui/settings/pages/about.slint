import { AboutSlint } from "std-widgets.slint";
import { Prefs } from "../bridge.slint";
import { Btn, Card, Hint, Label, Page } from "../controls.slint";

export component AboutPage inherits Page {
    Card {
        title: "wispr-free " + Prefs.version;
        hint: "Free, fully local voice typing. Nothing leaves this computer.";

        HorizontalLayout {
            alignment: start;

            Btn {
                width: 150px;
                text: "Check for updates";
                clicked => {
                    Prefs.check-for-updates();
                }
            }
        }

        Hint {
            text: "Opens the releases page in your browser. The app never checks by itself.";
        }
    }

    Card {
        title: "Licenses";

        Label {
            text: "wispr-free is MIT licensed.";
        }

        Label {
            text: "Built with Slint under the Slint Royalty-free License 2.0.";
        }

        Label {
            text: "Each model's license is listed on the Models page.";
        }

        AboutSlint {
            preferred-height: 160px;
        }
    }
}
