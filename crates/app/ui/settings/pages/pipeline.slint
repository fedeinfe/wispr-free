import { Prefs, ModelRow } from "../bridge.slint";
import { Theme } from "../theme.slint";
import { Btn, Card, ErrorText, Hint, Page, SelectRow, StatusMark, StepperRow, ToggleRow } from "../controls.slint";

// Under a stage's model menu: whether that model is on disk, and the way to get it if not.
component ModelState inherits VerticalLayout {
    in property <int> model-row;
    // A stage that's off needs no model, so nothing is missing.
    in property <bool> needed: true;

    property <ModelRow> model: Prefs.models[root.model-row];
    property <bool> reachable: !Prefs.models-folder-missing;
    property <bool> missing: root.needed && root.reachable && !root.model.installed;
    property <bool> downloading: root.missing && root.model.downloading;

    spacing: 4px;

    HorizontalLayout {
        spacing: 8px;

        if root.needed: VerticalLayout {
            alignment: center;

            StatusMark {
                ok: root.reachable && root.model.installed;
            }
        }

        Hint {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: !root.needed ? "Not used: this stage is off"
                : !root.reachable ? "Folder not connected"
                : root.model.installed ? "Downloaded"
                : root.downloading ? "Downloading…"
                : root.model.partial ? root.model.status + " of " + root.model.size
                : "Not downloaded · " + root.model.size;
        }

        if root.downloading: Btn {
            width: 76px;
            text: "Cancel";
            accessible-label: "Cancel download";
            clicked => {
                Prefs.cancel-download();
            }
        }

        if root.missing && !root.downloading: Btn {
            width: 86px;
            text: root.model.partial ? "Resume" : "Download";
            accessible-label: "Download " + root.model.name;
            enabled: !Prefs.model-busy;
            clicked => {
                Prefs.download-model(root.model-row);
            }
        }
    }

    if root.downloading: Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.track;
        clip: true;

        Rectangle {
            x: 0;
            width: parent.width * root.model.progress;
            background: Theme.accent;
        }
    }
}

export component PipelinePage inherits Page {
    Card {
        title: "Quality";
        hint: "A tier sets the stages and models below. Changing one of them makes it Custom.";

        SelectRow {
            label: "Quality tier";
            options: ["Lite", "Balanced", "High", "Custom"];
            current <=> Prefs.values.tier;
        }
    }

    Card {
        title: "Stages";

        ToggleRow {
            label: "Noise suppression";
            hint: "For noisy rooms and cheap mics.";
            checked <=> Prefs.values.denoise;
        }

        if Prefs.vad-forced: ToggleRow {
            label: "Silence trimming (VAD)";
            hint: "Always on with Whisper, which invents text in silence.";
            enabled: false;
            checked: true;
        }

        if !Prefs.vad-forced: ToggleRow {
            label: "Silence trimming (VAD)";
            checked <=> Prefs.values.vad;
        }

        ToggleRow {
            label: "LLM cleanup";
            hint: "Rewrites the transcript with a local model.";
            checked <=> Prefs.values.llm-cleanup;
        }

        SelectRow {
            label: "Cleanup strength";
            options: ["None", "Light", "Medium", "High"];
            current <=> Prefs.values.cleanup-strength;
        }

        ToggleRow {
            label: "Stop hands-free after silence";
            checked <=> Prefs.values.vad-auto-stop;
        }

        StepperRow {
            label: "Silence before stopping";
            unit: "s";
            minimum: 1;
            maximum: 60;
            enabled: Prefs.values.vad-auto-stop;
            value <=> Prefs.values.vad-auto-stop-seconds;
        }
    }

    Card {
        title: "Models";

        SelectRow {
            label: "Speech recognition";
            options: Prefs.asr-options;
            current <=> Prefs.values.asr-model;
        }

        if Prefs.values.asr-model >= 0: ModelState {
            model-row: Prefs.asr-rows[Prefs.values.asr-model];
        }

        SelectRow {
            label: "Voice detection";
            options: Prefs.vad-options;
            current <=> Prefs.values.vad-model;
        }

        if Prefs.values.vad-model >= 0: ModelState {
            model-row: Prefs.vad-rows[Prefs.values.vad-model];
            needed: Prefs.vad-forced || Prefs.values.vad;
        }

        SelectRow {
            label: "Cleanup model";
            options: Prefs.llm-options;
            current <=> Prefs.values.llm-model;
        }

        if Prefs.values.llm-model >= 0: ModelState {
            model-row: Prefs.llm-rows[Prefs.values.llm-model];
            needed: Prefs.values.llm-cleanup;
        }

        SelectRow {
            label: "Keep models loaded";
            options: ["Always", "For 5 minutes", "Unload after use"];
            current <=> Prefs.values.keep-models-loaded;
        }

        if Prefs.model-error != "": ErrorText {
            text: Prefs.model-error;
        }
    }
}
