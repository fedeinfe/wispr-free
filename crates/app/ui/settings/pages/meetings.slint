import { Prefs } from "../bridge.slint";
import { Card, Field, Label, Page, StepperRow, ToggleRow } from "../controls.slint";

export component MeetingsPage inherits Page {
    Card {
        title: "Recording";

        ToggleRow {
            label: "Suggest notes when a meeting starts";
            hint: "Asks first. It never records by itself.";
            checked <=> Prefs.values.meeting-auto-detect;
        }

        ToggleRow {
            label: "Live transcript";
            checked <=> Prefs.values.meeting-live-transcript;
        }

        ToggleRow {
            label: "Keep the audio after the transcript is final";
            checked <=> Prefs.values.meeting-keep-audio;
        }

        StepperRow {
            label: "Maximum length";
            unit: "min";
            minimum: 15;
            maximum: 480;
            step: 15;
            value <=> Prefs.values.meeting-max-length-minutes;
        }
    }

    Card {
        title: "After the meeting";

        ToggleRow {
            label: "Refine pass";
            hint: "Transcribes again with the larger model.";
            checked <=> Prefs.values.meeting-refine-pass;
        }

        ToggleRow {
            label: "Tell speakers apart";
            checked <=> Prefs.values.meeting-diarization;
        }

        Label {
            text: "Summary template";
        }

        Field {
            label: "Summary template";
            placeholder: "Extra instructions for the summary. Leave empty for the standard sections.";
            multiline: true;
            text <=> Prefs.values.meeting-summary-template;
            edited => {
                Prefs.commit();
            }
        }
    }
}
