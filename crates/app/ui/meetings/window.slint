// The Meetings window (spec §4). Rust creates it on open and drops it on close, like Settings, and
// it uses Settings' palette and controls.
import { ScrollView, TextEdit, Palette } from "std-widgets.slint";
import { Prefs } from "../settings/bridge.slint";
import { Theme } from "../settings/theme.slint";
import { Btn, ErrorText, Field, Hint, Label, SidebarBrand, StatusMark } from "../settings/controls.slint";
import {
    ChatBlock, ChatChip, ChatMessage, MeetingRow, MeetingsUi, SpeakerRow, StageRow, SummaryLine,
    TranscriptLine,
} from "bridge.slint";

export { ChatBlock, ChatChip, ChatMessage, MeetingRow, MeetingsUi, SpeakerRow, StageRow, SummaryLine, TranscriptLine }

// A time in the meeting. A time with no line behind it is shown as such and leads nowhere.
component TimeChip inherits Rectangle {
    in property <string> label;
    in property <int> target;
    property <bool> real: target >= 0;

    width: text.preferred-width + 12px;
    height: 20px;
    border-radius: Theme.small-radius;
    background: real && touch.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: real ? Theme.accent : Theme.line;
    accessible-role: button;
    accessible-label: real ? "Go to " + label : label + " matches no line of the transcript";
    accessible-enabled: real;
    accessible-action-default => {
        if real {
            MeetingsUi.jump(target);
        }
    }

    text := Text {
        text: root.real ? root.label : root.label + " ?";
        color: root.real ? Theme.accent : Theme.muted;
        font-size: Theme.small-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.real;
        mouse-cursor: pointer;
        clicked => {
            MeetingsUi.jump(root.target);
        }
    }
}

component Mark inherits Rectangle {
    in property <color> tone;

    width: 8px;
    height: 8px;
    border-radius: Theme.small-radius;
    background: tone;
}

component MeetingItem inherits Rectangle {
    in property <MeetingRow> meeting;
    in property <bool> selected;

    min-height: content.preferred-height;
    border-radius: Theme.control-radius;
    background: selected ? Theme.accent-soft : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    accessible-role: list-item;
    accessible-label: meeting.title;
    accessible-item-selected: selected;
    accessible-action-default => {
        MeetingsUi.select(meeting.id, meeting.hit-row);
    }

    content := VerticalLayout {
        padding: 8px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 2px;

        HorizontalLayout {
            spacing: 6px;

            if root.meeting.recording: VerticalLayout {
                alignment: center;

                Mark {
                    tone: Theme.danger;
                }
            }

            if root.meeting.busy: VerticalLayout {
                alignment: center;

                Mark {
                    tone: Theme.accent;
                }
            }

            Text {
                horizontal-stretch: 1;
                text: root.meeting.title;
                color: Theme.text;
                font-size: Theme.body-text;
                overflow: elide;
            }

            if root.meeting.failed: StatusMark {
                ok: false;
            }
        }

        Text {
            text: root.meeting.when;
            color: Theme.muted;
            font-size: Theme.small-text;
            overflow: elide;
        }

        if root.meeting.snippet != "": Hint {
            text: root.meeting.snippet;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            MeetingsUi.select(root.meeting.id, root.meeting.hit-row);
        }
    }
}

component Sidebar inherits Rectangle {
    background: Theme.sidebar;

    VerticalLayout {
        padding: 14px;
        padding-top: 20px;
        spacing: 12px;

        SidebarBrand { }

        Btn {
            text: MeetingsUi.recording ? "Stop meeting notes" : "Start meeting notes";
            primary: !MeetingsUi.recording;
            clicked => {
                MeetingsUi.toggle-meeting();
            }
        }

        Field {
            label: "Search meetings";
            placeholder: "Search meetings";
            text <=> MeetingsUi.query;
            edited => {
                MeetingsUi.search();
            }
        }

        list := ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                width: list.visible-width;
                spacing: 2px;
                alignment: start;

                if MeetingsUi.meetings.length == 0: Hint {
                    text: MeetingsUi.list-hint;
                }

                for meeting in MeetingsUi.meetings: MeetingItem {
                    meeting: meeting;
                    selected: meeting.id == MeetingsUi.selected-id;
                }
            }
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> label;
    in property <int> index;
    property <bool> selected: MeetingsUi.tab == index;

    width: text.preferred-width + 24px;
    height: 32px;
    accessible-role: tab;
    accessible-label: label;
    accessible-item-selected: selected;
    accessible-action-default => {
        MeetingsUi.tab = index;
    }

    text := Text {
        text: root.label;
        color: root.selected ? Theme.text : Theme.muted;
        font-size: Theme.body-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.selected ? Theme.accent : transparent;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            MeetingsUi.tab = root.index;
        }
    }
}

component StageChip inherits HorizontalLayout {
    in property <StageRow> stage;

    spacing: 5px;

    if root.stage.state == 1 || root.stage.state == 3: VerticalLayout {
        alignment: center;

        StatusMark {
            ok: root.stage.state == 1;
        }
    }

    Text {
        text: root.stage.state == 2 ? root.stage.label + " off" : root.stage.label;
        color: root.stage.state == 1 || root.stage.state == 3 ? Theme.text : Theme.muted;
        font-size: Theme.small-text;
        vertical-alignment: center;
    }
}

component Header inherits VerticalLayout {
    property <bool> confirming-delete;

    padding: 16px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 8px;
    spacing: 8px;

    HorizontalLayout {
        spacing: 8px;

        Field {
            horizontal-stretch: 1;
            label: "Meeting title";
            placeholder: "Untitled meeting";
            text <=> MeetingsUi.title;
            edited => {
                MeetingsUi.title-edited();
            }
        }

        if MeetingsUi.can-resume: Btn {
            text: "Keep recording";
            clicked => {
                MeetingsUi.resume();
            }
        }

        if !MeetingsUi.this-recording: Btn {
            text: "Export";
            clicked => {
                MeetingsUi.export();
            }
        }

        if !root.confirming-delete && !MeetingsUi.busy && !MeetingsUi.this-recording: Btn {
            text: "Delete";
            danger: true;
            clicked => {
                root.confirming-delete = true;
            }
        }

        if root.confirming-delete: Btn {
            text: "Keep it";
            clicked => {
                root.confirming-delete = false;
            }
        }

        if root.confirming-delete: Btn {
            text: "Delete for good";
            danger: true;
            clicked => {
                root.confirming-delete = false;
                MeetingsUi.delete();
            }
        }
    }

    Hint {
        text: MeetingsUi.when;
    }

    HorizontalLayout {
        spacing: 14px;
        alignment: start;

        for stage in MeetingsUi.stages: StageChip {
            stage: stage;
        }

        if MeetingsUi.can-finish: Btn {
            text: "Finish processing";
            height: 22px;
            clicked => {
                MeetingsUi.finish();
            }
        }
    }

    if MeetingsUi.progress-text != "": HorizontalLayout {
        spacing: 10px;

        Hint {
            horizontal-stretch: 1;
            text: MeetingsUi.progress-text;
            vertical-alignment: center;
        }

        if MeetingsUi.progress >= 0: VerticalLayout {
            alignment: center;
            width: 120px;

            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.track;

                Rectangle {
                    x: 0;
                    width: parent.width * max(0, min(1, MeetingsUi.progress));
                    border-radius: 2px;
                    background: Theme.accent;
                }
            }
        }

        if MeetingsUi.busy: Btn {
            text: "Cancel";
            height: 22px;
            clicked => {
                MeetingsUi.cancel-work();
            }
        }
    }

    if MeetingsUi.failures != "": ErrorText {
        text: MeetingsUi.failures;
    }

    if MeetingsUi.notice != "": ErrorText {
        text: MeetingsUi.notice;
    }

    HorizontalLayout {
        alignment: start;

        TabButton {
            label: "Summary";
            index: 0;
        }

        TabButton {
            label: "Notes";
            index: 1;
        }

        TabButton {
            label: "Transcript";
            index: 2;
        }

        TabButton {
            label: "Chat";
            index: 3;
        }
    }
}

component SummaryPanel inherits Rectangle {
    scroller := ScrollView {
        VerticalLayout {
            width: scroller.visible-width;
            padding: 24px;
            padding-top: 12px;
            spacing: 8px;
            alignment: start;

            HorizontalLayout {
                spacing: 8px;

                Hint {
                    horizontal-stretch: 1;
                    text: "Written by the model, so it can miss or misread things. The transcript is one click away.";
                    vertical-alignment: center;
                }

                if MeetingsUi.summary-stale: Btn {
                    text: "Update summary";
                    enabled: MeetingsUi.can-summarize;
                    clicked => {
                        MeetingsUi.update-summary();
                    }
                }

                Btn {
                    text: "Regenerate";
                    enabled: MeetingsUi.can-summarize;
                    clicked => {
                        MeetingsUi.regenerate();
                    }
                }
            }

            if MeetingsUi.summary-stale: Hint {
                text: "The transcript changed after this summary was written.";
            }

            if MeetingsUi.summary-partial: Hint {
                text: "This came straight from the notes on each part, because the last step failed. Regenerating may do better.";
            }

            if MeetingsUi.summary-empty != "": Label {
                text: MeetingsUi.summary-empty;
            }

            for line in MeetingsUi.summary: VerticalLayout {
                if line.kind == 0: Text {
                    text: line.text;
                    color: Theme.text;
                    font-size: Theme.body-text;
                    font-weight: 600;
                }

                if line.kind == 1: HorizontalLayout {
                    spacing: 8px;

                    Label {
                        horizontal-stretch: 1;
                        text: "• " + line.text;
                    }

                    if line.time != "": VerticalLayout {
                        alignment: start;

                        TimeChip {
                            label: line.time;
                            target: line.row;
                        }
                    }
                }

                if line.kind == 2: Label {
                    text: line.text;
                }
            }
        }
    }
}

component NotesPanel inherits VerticalLayout {
    padding: 24px;
    padding-top: 12px;
    spacing: 6px;

    Hint {
        text: "Yours. The summary and the chat can read them.";
    }

    TextEdit {
        vertical-stretch: 1;
        wrap: word-wrap;
        font-size: Theme.body-text;
        text <=> MeetingsUi.notes;
        edited => {
            MeetingsUi.notes-edited();
        }
    }
}

component TranscriptRowView inherits Rectangle {
    in property <TranscriptLine> line;
    in property <int> index;
    property <bool> aimed: MeetingsUi.jump-row == index;
    property <int> aim: aimed ? MeetingsUi.jump-seq : 0;
    callback show-me(y: length);

    min-height: content.preferred-height;
    border-radius: Theme.small-radius;
    background: aimed ? Theme.hover : transparent;

    changed aim => {
        if aimed {
            root.show-me(self.y);
        }
    }

    content := HorizontalLayout {
        padding: 4px;
        spacing: 10px;

        Text {
            width: 52px;
            text: root.line.time;
            color: Theme.muted;
            font-size: Theme.small-text;
        }

        if !root.line.gap: VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;

            Text {
                text: root.line.speaker;
                color: Theme.accent;
                font-size: Theme.small-text;
            }

            Label {
                text: root.line.text;
            }
        }

        if root.line.gap: Hint {
            horizontal-stretch: 1;
            text: root.line.text;
        }
    }
}

component TranscriptPanel inherits VerticalLayout {
    // Reading this makes the rows while the panel is out of sight, so that a jump finds them.
    property <length> length-of-rows: scroller.content-height;

    changed length-of-rows => { }

    padding-top: 8px;
    spacing: 6px;

    if MeetingsUi.speakers.length > 0: HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 10px;
        alignment: start;

        for speaker in MeetingsUi.speakers: HorizontalLayout {
            spacing: 4px;

            Hint {
                text: speaker.label;
                vertical-alignment: center;
            }

            Field {
                width: 120px;
                label: "Name of " + speaker.label;
                placeholder: "Name";
                text: speaker.name;
                edited => {
                    MeetingsUi.speaker-edited(speaker.id, self.text);
                }
            }
        }
    }

    scroller := ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            width: scroller.visible-width;
            padding: 24px;
            padding-top: 4px;
            spacing: 2px;
            alignment: start;

            if MeetingsUi.transcript-empty != "": Label {
                text: MeetingsUi.transcript-empty;
            }

            for line[index] in MeetingsUi.transcript: TranscriptRowView {
                line: line;
                index: index;
                show-me(y) => {
                    scroller.content-y = max(scroller.visible-height - scroller.content-height, min(0, 24px - y));
                }
            }
        }
    }
}

component ChatQuestion inherits Rectangle {
    in property <string> text;

    min-height: label.preferred-height + 12px;
    border-radius: Theme.control-radius;
    background: Theme.control;

    label := Label {
        x: 10px;
        y: 6px;
        width: parent.width - 20px;
        text: root.text;
    }
}

component ChatPanel inherits VerticalLayout {
    property <string> following: MeetingsUi.streaming-text;
    property <int> messages: MeetingsUi.chat.length;
    property <bool> asked: messages > 0 || MeetingsUi.streaming-question != "";

    function to-the-end() {
        scroller.content-y = min(0, scroller.visible-height - scroller.content-height);
    }

    changed following => {
        root.to-the-end();
    }

    changed messages => {
        root.to-the-end();
    }

    padding-top: 8px;
    spacing: 8px;

    scroller := ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            width: scroller.visible-width;
            padding: 24px;
            padding-top: 4px;
            spacing: 12px;
            alignment: start;

            if !root.asked: Hint {
                text: "Answers come only from this meeting, and each one shows the times it rests on.";
            }

            for message in MeetingsUi.chat: VerticalLayout {
                spacing: 6px;

                ChatQuestion {
                    text: message.question;
                }

                for block in message.blocks: VerticalLayout {
                    spacing: 3px;

                    Label {
                        text: block.text;
                    }

                    if block.chips.length > 0: HorizontalLayout {
                        spacing: 4px;
                        alignment: start;

                        for chip in block.chips: TimeChip {
                            label: chip.label;
                            target: chip.row;
                        }
                    }
                }

                if message.note != "": Hint {
                    text: message.note;
                }
            }

            if MeetingsUi.streaming-question != "": VerticalLayout {
                spacing: 6px;

                ChatQuestion {
                    text: MeetingsUi.streaming-question;
                }

                Label {
                    text: MeetingsUi.streaming-text == "" ? "Thinking…" : MeetingsUi.streaming-text;
                }
            }

            if MeetingsUi.chat-error != "": ErrorText {
                text: MeetingsUi.chat-error;
            }
        }
    }

    if !MeetingsUi.chat-running: HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 6px;
        alignment: start;

        for suggestion in MeetingsUi.suggestions: Btn {
            text: suggestion;
            clicked => {
                MeetingsUi.ask(suggestion);
            }
        }
    }

    HorizontalLayout {
        padding: 24px;
        padding-top: 0;
        spacing: 8px;

        input := Field {
            horizontal-stretch: 1;
            label: "Ask about this meeting";
            placeholder: "Ask about this meeting";
            accepted => {
                if !MeetingsUi.chat-running && self.text != "" {
                    MeetingsUi.ask(self.text);
                    self.text = "";
                }
            }
        }

        if !MeetingsUi.chat-running: Btn {
            text: "Send";
            primary: true;
            enabled: input.text != "";
            clicked => {
                MeetingsUi.ask(input.text);
                input.text = "";
            }
        }

        if MeetingsUi.chat-running: Btn {
            text: "Stop";
            clicked => {
                MeetingsUi.stop-chat();
            }
        }
    }
}

export component MeetingsWindow inherits Window {
    property <int> theme: Prefs.theme;

    function apply-theme() {
        Palette.color-scheme = Prefs.theme == 1 ? ColorScheme.light : Prefs.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    title: "wispr-free meetings";
    icon: @image-url("../icons/tray.svg");
    preferred-width: 980px;
    preferred-height: 680px;
    min-width: 760px;
    min-height: 480px;
    background: Theme.background;

    init => {
        Theme.system-dark = Palette.color-scheme == ColorScheme.dark;
        if Prefs.theme != 0 {
            root.apply-theme();
        }
    }

    changed theme => {
        root.apply-theme();
    }

    HorizontalLayout {
        Sidebar {
            width: 270px;
        }

        if MeetingsUi.selected-id == "": Rectangle {
            horizontal-stretch: 1;

            Hint {
                width: 320px;
                text: MeetingsUi.meetings.length == 0 ? "" : "Pick a meeting to see its summary, notes, transcript and chat.";
                horizontal-alignment: center;
            }
        }

        if MeetingsUi.selected-id != "": VerticalLayout {
            horizontal-stretch: 1;

            Header { }

            Rectangle {
                vertical-stretch: 1;

                // All four stay alive, so that a jump can place the transcript before it shows.
                SummaryPanel {
                    visible: MeetingsUi.tab == 0;
                }

                NotesPanel {
                    visible: MeetingsUi.tab == 1;
                }

                TranscriptPanel {
                    visible: MeetingsUi.tab == 2;
                }

                ChatPanel {
                    visible: MeetingsUi.tab == 3;
                }
            }
        }
    }
}
